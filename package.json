{
  "name": "eyesbound",
  "version": "3.0.0",
  "private": true,
  "description": "Website for Berlin based Photographer",
  "license": "0BSD",
  "repository": "github:Primajin/eyesbound",
  "author": "Jannis Hell",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "astro:build": "astro build",
    "astro:dev": "astro dev",
    "astro:preview": "astro preview",
    "build": "gatsby build",
    "clean": "gatsby clean",
    "coverage": "JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --reporters=jest-junit --ci --coverage",
    "develop": "gatsby clean && gatsby develop -S",
    "lint": "xo --config eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,jsx,json",
    "serve": "gatsby serve",
    "start": "npm run develop",
    "start:lan": "npm run develop -- -o -H 0.0.0.0 -p 8000",
    "test": "jest",
    "test:astro": "vitest run",
    "test:astro:coverage": "vitest run --coverage",
    "test:update": "npm test -- -u",
    "test:watch": "npm test -- --watch"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/montserrat": "^5.3.0",
    "@prismicio/client": "^7.22.3",
    "@react-google-maps/api": "^2.20.8",
    "astro": "^7.4.2",
    "classnames": "^2.5.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-csp": "^1.1.4",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-offline": "^6.16.0",
    "gatsby-plugin-react-helmet": "^6.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-source-prismic": "^6.0.3",
    "i18next": "^26.4.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet": "^6.1.0",
    "react-i18next": "^17.0.15",
    "react-slideshow-image": "^4.4.0"
  },
  "devDependencies": {
    "@codecov/webpack-plugin": "^2.0.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/jest": "^11.14.2",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "babel-jest": "^30.5.2",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-config-xo-react": "^0.32.0",
    "eslint-plugin-jest": "^29.16.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "xo": "^5.0.1"
  },
  "overrides": {
    "@codecov/webpack-plugin": {
      "webpack": "5.x"
    },
    "@graphql-tools/utils": "^12.0.1",
    "cookie": "^2.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "immutable": "^5.0.0",
    "katex": "^0.19.0",
