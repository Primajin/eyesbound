{
  "name": "eyesbound",
  "version": "3.0.0",
  "private": true,
  "description": "Website for Berlin based Photographer",
  "license": "0BSD",
  "repository": "github:Primajin/eyesbound",
  "author": "Jannis Hell",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "prebuild": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "build": "astro build",
    "coverage": "vitest run --coverage",
    "dev": "astro dev",
    "lint": "xo --config eslint.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "lint:watch": "npx nodemon -x npm run lint:fix --ext js,json",
    "preview": "astro preview",
    "start": "npm run dev",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/montserrat": "^5.3.0",
    "@prismicio/client": "^7.22.3",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-jest": "^29.16.6",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "xo": "^5.0.1"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
