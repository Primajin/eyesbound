{
	// Separate Worker from the site (root wrangler.jsonc). Free plan is enough.
	// Deploy from this directory by hand: npx wrangler@4.152.0 deploy
	"name": "eyesbound-prismic-relay",
	"main": "src/index.js",
	"compatibility_date": "2026-10-22",
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"GITHUB_REPO": "Primajin/eyesbound",
		"GITHUB_REF": "main"
	}
	// Secrets (never in this file): PRISMIC_WEBHOOK_SECRET, GITHUB_TOKEN
	// -> npx wrangler@4.152.0 secret put <NAME>
}
