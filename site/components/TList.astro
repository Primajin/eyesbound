---
import {tCount} from '../i18n/index.js';

import T from './T.astro';

interface Props {
	/** Key of a translated list, e.g. `privacy.s5.b.list` */
	key: string;
	params?: Record<string, string>;
}

const {key, params = {}} = Astro.props;
---

<ul>
	{Array.from({length: tCount(key)}, (_item, index) => <li><T key={`${key}.${index}`} params={params} /></li>)}
</ul>
