---
import {preparePolicyHtml} from '../utils/policy.js';

interface Props {
	lang: string;
}

const {lang} = Astro.props;
const {body, closing} = preparePolicyHtml(await Astro.slots.render('default'));
---

<div class="policy" data-lang={lang} lang={lang}>
	<Fragment set:html={body} />
	<slot name="consent" />
	<Fragment set:html={closing} />
</div>

<style>
	.policy :global(h3) {
		font-size: 100%;
		text-transform: none;
	}
</style>
