---
import T from './T.astro';
---

<button type="button" class="theme-switcher" data-theme-switcher>
	<span class="visually-hidden"><T key="accessibility.switchTheme" /></span>
	<svg class="bulb-on" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" d="M0 0h24v24H0z"></path><path d="M9 21c0 .5.4 1 1 1h4c.6 0 1-.5 1-1v-1H9v1zm3-19a7 7 0 00-4 12.7V17c0 .5.4 1 1 1h6c.6 0 1-.5 1-1v-2.3A7 7 0 0012 2z"></path></svg>
	<svg class="bulb-off" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" d="M0 0h24v24H0z"></path><path d="M9 21c0 .6.5 1 1 1h4c.6 0 1-.5 1-1v-1H9v1zm3-19a7 7 0 00-4 12.7V17c0 .6.5 1 1 1h6c.6 0 1-.5 1-1v-2.3A7 7 0 0012 2zm2.9 11.1l-.9.6V16h-4v-2.3l-.8-.6a5 5 0 115.7 0z"></path></svg>
</button>

<script>
	import '../scripts/theme-switcher.js';
</script>

<style>
	.theme-switcher {
		align-items: center;
		background-color: var(--foreground);
		color: var(--background);
		cursor: pointer;
		display: flex;
		height: var(--control-size);
		inset-block-start: 0;
		inset-inline-end: var(--control-size);
		justify-content: center;
		opacity: 1;
		padding: 0;
		position: fixed;
		transition: background-color var(--theme-duration), color var(--theme-duration), opacity var(--theme-duration);
		width: var(--control-size);
		z-index: var(--z-controls);
	}

	.theme-switcher:hover {
		background: var(--background);
		color: var(--foreground);
	}

	/* Button surface is the foreground colour, so the ring uses the background colour to stay visible */
	.theme-switcher:focus-visible {
		outline: 2px solid var(--background);
		outline-offset: -4px;
	}

	.theme-switcher:hover:focus-visible {
		outline-color: var(--foreground);
	}

	:global(:root[data-fullscreen]) .theme-switcher:not(:hover, :focus-visible) {
		opacity: 0.65;
	}

	svg {
		fill: currentcolor;
		height: var(--icon-size);
		width: var(--icon-size);
	}

	/* Light shows the lit bulb, dark the outlined one (as in the Gatsby version) */
	.bulb-off {
		display: none;
	}

	/* :global() needed: the theme attribute lives on <html>, outside this component's scope */
	:global(:root[data-theme='dark']) .bulb-on {
		display: none;
	}

	:global(:root[data-theme='dark']) .bulb-off {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme])) .bulb-on {
			display: none;
		}

		:global(:root:not([data-theme])) .bulb-off {
			display: block;
		}
	}
</style>
