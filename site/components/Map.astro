---
import {getImage} from 'astro:assets';
import {MAPS_API_KEY as apiKey} from 'astro:env/client';

import {centerOfGermany} from '../constants/map.js';
import T from './T.astro';
import {isUsingFixtures, routes} from '../lib/prismic.js';
import {planImage} from '../utils/image.js';
import '../styles/map.css';

interface Props {
	/** Pictures with usable coordinates (see getMapPictures) */
	pictures: {uid: string; title: string | null; coordinates: {latitude: number; longitude: number}; image: any; thumbnail: any}[];
	center?: {latitude: number; longitude: number};
	zoom?: number;
	/** Markers open a window linking to the picture */
	hasInfoWindow?: boolean;
	/** Id of the element that names the map for assistive technology */
	labelledBy: string;
	fullscreen?: boolean;
}

const {pictures, center = centerOfGermany, zoom = 5, hasInfoWindow = false, labelledBy, fullscreen = false} = Astro.props;
if (pictures.length === 0) {
	throw new TypeError('Map rendered without pictures.');
}

if (!apiKey && !isUsingFixtures()) {
	throw new Error('MAPS_API_KEY is missing. Set it for a real build (the maps key is public and referrer-restricted), or set PRISMIC_FIXTURES=1 for a local fixture build.');
}

const infoImage = async picture => {
	const source = picture.thumbnail ?? picture.image;
	if (!source) {
		return null;
	}

	const shown = planImage(source, 164, picture.title ?? '');
	const {src} = await getImage({
		src: shown.src, alt: shown.alt, width: Math.min(328, source.width), height: Math.round(Math.min(328, source.width) * source.height / source.width), format: 'webp',
	});
	return {src, width: shown.width, height: shown.height, alt: shown.alt};
};

const data = await Promise.all(pictures.map(async picture => ({
	uid: picture.uid,
	title: picture.title ?? picture.uid,
	href: routes.picture(picture.uid),
	latitude: picture.coordinates.latitude,
	longitude: picture.coordinates.longitude,
	image: hasInfoWindow ? await infoImage(picture) : null,
})));
---

<div
	class:list={['map', {fullscreen}]}
	role="region"
	aria-labelledby={labelledBy}
	data-map
	data-api-key={apiKey}
	data-pictures={JSON.stringify(data)}
	data-latitude={center.latitude}
	data-longitude={center.longitude}
	data-zoom={zoom}
	data-info-window={hasInfoWindow ? '' : undefined}
>
	<div class="consent" data-map-consent hidden>
		<p><T key="map.consent.text" /></p>
		<p><a href="/imprint/#privacy-policy"><T key="map.consent.privacy" /></a></p>
		<button type="button"><T key="map.consent.load" /></button>
	</div>
</div>

<script>
	import '../scripts/map-init.js';
</script>

<style>
	.map {
		background: var(--background);
		block-size: 500px;
		inline-size: 100%;
		position: relative;
	}

	.map.fullscreen {
		block-size: 100dvh;
		inset: 0;
		position: fixed;
	}

	.consent {
		align-items: center;
		border: 1px solid var(--foreground);
		flex-direction: column;
		gap: 1rem;
		inset: 0;
		justify-content: center;
		padding: 1rem;
		position: absolute;
		text-align: center;
	}

	.consent:not([hidden]) {
		display: flex;
	}

	.consent p {
		margin: 0;
		max-inline-size: 40rem;
	}

	.consent a {
		text-decoration: underline;
	}

	.consent button {
		background: var(--foreground);
		color: var(--background);
		cursor: pointer;
		min-block-size: var(--control-size);
		padding: 0 1.5rem;
		text-transform: uppercase;
	}

	.map :global(.map-layer) {
		inset: 0;
		position: absolute;
	}
</style>
