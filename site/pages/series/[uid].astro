---
import Member from '../../components/Member.astro';
import {AssetTypes} from '../../constants/asset-types.js';
import Base from '../../layouts/Base.astro';
import {getPicturesBySeries, getStaticPathsFor} from '../../lib/prismic.js';

export const getStaticPaths = () => getStaticPathsFor('series');

const {name} = AssetTypes.SERIES;
const {item} = Astro.props;
const title = item.title ?? item.uid;
const pictures = await getPicturesBySeries(item.uid);
---

<Base title={title}>
	<Member pictures={pictures} name={name} title={title} />
</Base>
