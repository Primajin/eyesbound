---
import Fullscreen from '../components/Fullscreen.astro';
import Slideshow from '../components/Slideshow.astro';
import Base from '../layouts/Base.astro';
import {getHomepagePictures} from '../lib/prismic.js';

const pictures = await getHomepagePictures();
if (pictures.length === 0) {
	throw new Error('No picture is flagged for the homepage: the slideshow would be empty.');
}
---

<Base imageSource={new URL('/social-image.png', Astro.site).href}>
	<Fullscreen selector="[data-slideshow]" />
	<main>
		<Slideshow pictures={pictures} />
	</main>
</Base>

<style is:global>
	body {
		block-size: 100dvh;
		overflow: hidden;
	}
</style>
