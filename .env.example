# Copy to .env.local and fill in. Never commit real values.
# Do not put secrets in .env: it is tracked by git and holds only the public defaults below.
# .env.* files (except this one) are ignored by git.

# Public site origin without trailing slash (canonical URLs, sitemap).
# Absent or blank: falls back to https://eyesbound.com
SITE_URL=https://eyesbound.com
# Site name used in titles. Absent: falls back to EYESBOUND (a blank value is used as is)
SITE_NAME=EYESBOUND

# Prismic repository name. Absent: falls back to eyesbound
PRISMIC_REPO_NAME=eyesbound
# Prismic access token, build-time only. Required for a real build (scripts/check-env.mjs fails without it).
# Never prefix with PUBLIC_.
PRISMIC_ACCESS_TOKEN=
# Google Maps browser key (referrer-restricted, ships to the client). Required for a real build.
MAPS_API_KEY=
