# Copy to .env.development (Gatsby) or .env.local (Astro) and fill in. Never commit real values.
# Do not put secrets in .env: it is tracked by git. .env.* files (except this one) are ignored.

# Public site origin without trailing slash (canonical URLs, sitemap). Defaults to https://eyesbound.com
GATSBY_SERVER_URL=https://eyesbound.com
# Site name used in titles. Defaults to EYESBOUND
GATSBY_SITE_NAME=EYESBOUND

# Prismic repository name. Defaults to eyesbound
PRISMIC_REPO_NAME=eyesbound
# Prismic access token, build-time only. Never prefix with PUBLIC_.
PRISMIC_ACCESS_TOKEN=

# Gatsby only (legacy, removed with Gatsby)
GATSBY_API_KEY=
GATSBY_G_MAPS=
